{
    "models": {
        "paraformer-large": {
            "name": "Paraformer Large",
            "kind": "capability",
            "engine": "funasr",
            "description": "中文 WebSocket 实时识别能力（Paraformer realtime stack）",
            "languages": [
                "zh"
            ],
            "default": false,
            "supports_realtime": true,
            "models": {
                "realtime": "iic/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-online"
            }
        },
        "qwen3-asr-confucius4-r2t2": {
            "name": "Confucius4-R2T2",
            "kind": "model",
            "engine": "qwen3",
            "description": "netease-youdao/Confucius4-R2T2，基于 Qwen3-ASR-1.7B 微调的低延迟高精度实时识别模型（中英优化）；CUDA 使用 vLLM，CPU/macOS 使用 QwenASR Rust backend",
            "languages": [
                "zh",
                "en",
                "yue",
                "ja",
                "ko",
                "ar",
                "de",
                "es",
                "fr",
                "pt",
                "id",
                "it",
                "ru",
                "th",
                "vi"
            ],
            "default": true,
            "supports_realtime": true,
            "models": {
                "offline": "${QWEN3_ASR_MODEL_PATH:-netease-youdao/Confucius4-R2T2}"
            },
            "extra_kwargs": {
                "max_model_len": 16384,
                "forced_aligner_path": "${QWEN3_FORCED_ALIGNER_PATH:-Qwen/Qwen3-ForcedAligner-0.6B}",
                "max_inference_batch_size": 16
            }
        },
        "qwen3-asr-0.6b": {
            "name": "Qwen3-ASR-0.6B",
            "kind": "model",
            "engine": "qwen3",
            "description": "Qwen3-ASR 0.6B，轻量版支持52种语言和方言；CUDA 使用 vLLM，CPU/macOS 使用 QwenASR Rust backend",
            "languages": [
                "zh",
                "en",
                "yue",
                "ja",
                "ko",
                "ar",
                "de",
                "es",
                "fr",
                "pt",
                "id",
                "it",
                "ru",
                "th",
                "vi"
            ],
            "default": false,
            "supports_realtime": true,
            "models": {
                "offline": "${QWEN3_ASR_MODEL_0_6B_PATH:-Qwen/Qwen3-ASR-0.6B}"
            },
            "extra_kwargs": {
                "max_model_len": 16384,
                "forced_aligner_path": "${QWEN3_FORCED_ALIGNER_PATH:-Qwen/Qwen3-ForcedAligner-0.6B}",
                "max_inference_batch_size": 16
            }
        }
    }
}
