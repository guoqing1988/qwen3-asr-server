# Qwen3-ASR environment
# Copy to .env and edit only the values you need to change.

# -----------------------------------------------------------------------------
# Public endpoint and auth.
# -----------------------------------------------------------------------------
# NGINX_PORT controls the host port used by docker-compose.
NGINX_PORT=9101

# Service listen port (systemd local deployment; docker scenarios use nginx forwarding to 8000).
# PORT=9101

# Leave empty to disable authentication.
# API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# Runtime selection.
# -----------------------------------------------------------------------------
# CUDA_VISIBLE_DEVICES=0

# Inference device: auto (auto-select), cuda:0, cpu.
# DEVICE=cuda:0

# Leave QWEN3_ASR_MODEL empty for automatic selection.
# Supported values: qwen3-asr-0.6b, qwen3-asr-1.7b
# QWEN3_ASR_MODEL=

# -----------------------------------------------------------------------------
# Model cache behavior.
# Default: download missing models at startup.
# -----------------------------------------------------------------------------
# HF_HUB_OFFLINE=1
# HF_ENDPOINT=https://hf-mirror.com

# ModelScope cache directory (local deployment: point to project models/ directory).
# MODELSCOPE_CACHE=/data/www/qwen3-asr/models/modelscope/hub/models

# HuggingFace cache directory (local deployment: point to project models/ directory).
# HF_HOME=/data/www/qwen3-asr/models/huggingface

# -----------------------------------------------------------------------------
# GPU memory control.
# -----------------------------------------------------------------------------
# vLLM GPU memory utilization (0.0-1.0) for the main ASR model.
# Default: auto-calculated (12GB / total VRAM). Lower to reduce resident VRAM.
# QWEN_GPU_MEMORY_UTILIZATION=0.20

# vLLM GPU memory utilization for the forced aligner (word-level timestamps).
# Default: inherits the main model value.
# QWEN_FORCE_ALIGNER_GPU_MEMORY_UTILIZATION=0.15

# Idle sleep timeout in seconds: sleeps the vLLM engines (weights offloaded to
# CPU, processes stay resident, wake-up <1s) after this many seconds without
# requests. Set 0 to disable. Set QWEN_ENABLE_SLEEP_MODE=false to restore the old
# behaviour of terminating the engines instead of sleeping them.
# QWEN_IDLE_UNLOAD_TIMEOUT=15

# Second tier: after this many more seconds of idleness the engines are fully shut
# down, giving back the CUDA context that sleep mode keeps reserved (~1.9GB for
# both engines). 0 disables. The next request then needs a full reload (11-21s).
# QWEN_SHUTDOWN_AFTER_S=600

# -----------------------------------------------------------------------------
# Realtime streaming (/ws/v1/asr/qwen) — Confucius4-R2T2 native usage.
# Decoding granularity matches the official R2T2 recommendation (80ms~2s).
# -----------------------------------------------------------------------------
# Decoding chunk size in seconds (official default 0.16). Smaller = lower latency.
# QWEN_STREAM_CHUNK_SEC=0.16

# Extra audio fed with the first chunk (seconds), helps the first segment decide
# language / proper nouns. Official example uses 0.16.
# QWEN_STREAM_LOOKAHEAD_SEC=0.16

# First N chunks do not use previous output as prefix (official default 0).
# QWEN_STREAM_UNFIXED_CHUNK_NUM=0

# Roll back the last K tokens of accumulated text when building the prefix
# (official default 1).
# QWEN_STREAM_UNFIXED_TOKEN_NUM=1

# Per-chunk generation cap. The actual value is dynamic:
# min(this cap, ~(chunk+lookahead)/1280*2). Set 0 to disable the cap.
# QWEN_STREAM_MAX_NEW_TOKENS=512

# Max duration of a single streaming segment, in seconds. VAD silence is the
# primary boundary; this is the fallback for continuous speech.
# QWEN_STREAM_SEGMENT_MAX_SEC=60

# Energy-threshold fallback when FireRedVAD is unavailable (seconds).
# QWEN_STREAM_SILENCE_SEC=2.0

# Inter-segment audio overlap. Official R2T2 is append-only and does not need
# overlap; keep 0 unless you have a special case.
# QWEN_STREAM_OVERLAP_SEC=0

# FireRedVAD Stream-VAD model directory (falls back to energy threshold if missing).
# QWEN_STREAM_VAD_MODEL_PATH=/data1/models/FireRedVAD/Stream-VAD

# Consecutive silence frames (10ms/frame) required to end a speech segment.
# QWEN_STREAM_VAD_MIN_SILENCE_FRAMES=20

# Two-pass: re-transcribe each finalized segment through the offline path with
# hotwords, fixing proper nouns that streaming append-only cannot revise.
# QWEN_STREAM_FINAL_PASS=true

# -----------------------------------------------------------------------------
# Voiceprint identification.
# Enabled by default. DB path is persisted by docker-compose through ./data.
# Tune the threshold only after validating your own audio samples.
# -----------------------------------------------------------------------------
VOICEPRINT_ENABLED=true
VOICEPRINT_DB_PATH=./data/voiceprints.sqlite3
VOICEPRINT_MATCH_THRESHOLD=0.70

# Voiceprint (CAM++) inference device. Defaults to auto: GPU when CUDA is available
# (per-segment input is capped at 30s, so peak VRAM is ~840MiB and it is 5-8x faster
# than CPU), CPU otherwise. Feeding hours of concatenated audio to the GPU used to
# blow up VRAM (measured CUDA OOM); chunking fixed that.
# VOICEPRINT_DEVICE=auto

# -----------------------------------------------------------------------------
# Hotwords context.
# Server-side preset hotwords, merged with per-request hotwords
# (OpenAI `prompt` / native `vocabulary_id`) before recognition.
# Comma-separated; multi-word phrases keep their internal spaces.
# Keep concise (recommended ≤512 chars) for best effect.
# -----------------------------------------------------------------------------
# ASR_DEFAULT_HOTWORDS=Alibaba,Tencent,OpenAI,Kubernetes,Bank of China
