# Qwen3-ASR environment
# Copy to .env and edit only the values you need to change.

# -----------------------------------------------------------------------------
# Public endpoint and auth.
# -----------------------------------------------------------------------------
# NGINX_PORT controls the host port used by docker-compose.
NGINX_PORT=9101

# Service listen port (systemd local deployment; docker scenarios use nginx forwarding to 8000).
# PORT=9101

# Leave empty to disable authentication.
# API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# Runtime selection.
# -----------------------------------------------------------------------------
# CUDA_VISIBLE_DEVICES=0

# Inference device: auto (auto-select), cuda:0, cpu.
# DEVICE=cuda:0

# Leave QWEN3_ASR_MODEL empty for automatic selection.
# Supported values: qwen3-asr-0.6b, qwen3-asr-1.7b
# QWEN3_ASR_MODEL=

# -----------------------------------------------------------------------------
# Model cache behavior.
# Default: download missing models at startup.
# -----------------------------------------------------------------------------
# HF_HUB_OFFLINE=1
# HF_ENDPOINT=https://hf-mirror.com

# ModelScope cache directory (local deployment: point to project models/ directory).
# MODELSCOPE_CACHE=/data/www/qwen3-asr/models/modelscope/hub/models

# HuggingFace cache directory (local deployment: point to project models/ directory).
# HF_HOME=/data/www/qwen3-asr/models/huggingface

# -----------------------------------------------------------------------------
# GPU memory control.
# -----------------------------------------------------------------------------
# vLLM GPU memory utilization (0.0-1.0) for the main ASR model.
# Default: auto-calculated (12GB / total VRAM). Lower to reduce resident VRAM.
# QWEN_GPU_MEMORY_UTILIZATION=0.20

# vLLM GPU memory utilization for the forced aligner (word-level timestamps).
# Default: inherits the main model value.
# QWEN_FORCE_ALIGNER_GPU_MEMORY_UTILIZATION=0.15

# Idle unload timeout in seconds: unloads the vLLM engines to release VRAM
# after this many seconds without requests. Set 0 to disable.
# QWEN_IDLE_UNLOAD_TIMEOUT=300

# -----------------------------------------------------------------------------
# Voiceprint identification.
# Enabled by default. DB path is persisted by docker-compose through ./data.
# Tune the threshold only after validating your own audio samples.
# -----------------------------------------------------------------------------
VOICEPRINT_ENABLED=true
VOICEPRINT_DB_PATH=./data/voiceprints.sqlite3
VOICEPRINT_MATCH_THRESHOLD=0.70

# -----------------------------------------------------------------------------
# Hotwords context.
# Server-side preset hotwords, merged with per-request hotwords
# (OpenAI `prompt` / native `vocabulary_id`) before recognition.
# Comma-separated; multi-word phrases keep their internal spaces.
# Keep concise (recommended ≤512 chars) for best effect.
# -----------------------------------------------------------------------------
# ASR_DEFAULT_HOTWORDS=Alibaba,Tencent,OpenAI,Kubernetes,Bank of China
